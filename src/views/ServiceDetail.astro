---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import FaqAccordion from '~/components/FaqAccordion.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';

import { site } from '~/data/site';
import { services, type Service } from '~/data/services';
import { faqsFor } from '~/data/faq';
import { alternateUrls, path, servicePath, useTranslations, type Locale } from '~/i18n/ui';
import { breadcrumbs, serviceSchema, faqSchema } from '~/lib/schema';

interface Props { service: Service; locale: Locale }
const { service, locale } = Astro.props;
const t = useTranslations(locale);
const copy = service[locale];
const alternates = alternateUrls({ kind: 'service', slug: service.slug });

const trail = [
  { name: t('nav.home'), url: path('home', locale) },
  { name: t('services.title'), url: path('services', locale) },
  { name: copy.name, url: servicePath(service.slug, locale) },
];

const serviceFaqs = faqsFor(service.slug);
const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

// Astro needs a static glob to resolve the image referenced by name in the data file.
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png}', {
  eager: true,
});
const heroImage = images[`/src/assets/images/${service.image}`]?.default;

const priceLabel =
  service.price === null
    ? t('label.quoted')
    : `${service.priceFrom ? t('label.from') + ' ' : ''}€${service.price}`;

/**
 * 90 → "1 hr 30 min", 480 → "8 hr", 30 → "30 min".
 * Greek inflects for number, so singular and plural units are separate strings.
 */
function formatDuration(mins: number | null): string {
  if (mins === null) return t('label.varies');
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  const parts: string[] = [];
  if (h) parts.push(`${h} ${t(h === 1 ? 'label.unitHrOne' : 'label.unitHr')}`);
  if (m) parts.push(`${m} ${t(m === 1 ? 'label.unitMinOne' : 'label.unitMin')}`);
  return parts.join(' ');
}
const durationLabel = formatDuration(service.duration);
---

<Base
  title={`${copy.name} | Piano Tunings Cy`}
  description={copy.metaDescription}
  alternates={alternates}
  schema={[
    breadcrumbs(trail),
    serviceSchema(service, locale),
    ...(serviceFaqs.length ? [faqSchema(serviceFaqs, locale)] : []),
  ]}
>
  <div class="bg-white">
    <Breadcrumbs trail={trail} locale={locale} />
  </div>

  <!-- Hero -->
  <section class="bg-white pb-16 pt-8 lg:pb-20">
    <div class="container-x">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16">
        <div>
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-sm bg-gold-50 text-gold-700">
            <Icon name={service.icon as any} class="h-6 w-6" />
          </span>
          <h1 class="mt-6 text-[2.4rem] leading-[1.08] text-ebony-950 sm:text-[3rem]">
            {copy.name}
          </h1>
          <p class="mt-4 font-display text-[1.4rem] leading-snug text-gold-700">{copy.tagline}</p>
          <div class="rule-gold mt-7"></div>

          <div class="mt-8 space-y-5">
            {copy.body.map((p) => <p class="prose-body">{p}</p>)}
          </div>

          <!-- Price / duration -->
          <dl class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-sm border border-ebony-200 bg-ebony-50 p-5">
              <dt class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-ebony-500">
                {t('label.price')}
              </dt>
              <dd class="mt-1.5 font-display text-[1.75rem] leading-none text-ebony-950">
                {priceLabel}
              </dd>
            </div>
            <div class="rounded-sm border border-ebony-200 bg-ebony-50 p-5">
              <dt class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-ebony-500">
                {t('label.duration')}
              </dt>
              <dd class="mt-1.5 flex items-center gap-2 font-display text-[1.75rem] leading-none text-ebony-950">
                <Icon name="clock" class="h-5 w-5 text-gold-600" />
                {durationLabel}
              </dd>
            </div>
          </dl>
          <p class="mt-4 text-[0.9rem] leading-relaxed text-ebony-500">{copy.priceNote}</p>

          <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row">
            <a
              href={`${path('book', locale)}?service=${service.slug}`}
              data-analytics={`service-book-${service.slug}`}
              class="btn-primary sm:!px-8"
            >
              {t('cta.bookService')}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <a href={`tel:${site.phone}`} data-analytics="service-call" class="btn-ghost sm:!px-8">
              <Icon name="phone" class="h-4 w-4" />
              {site.phoneDisplay}
            </a>
          </div>
        </div>

        <!-- Image + includes -->
        <div class="lg:sticky lg:top-32">
          {
            heroImage && (
              <Image
                src={heroImage}
                alt={copy.name}
                width={900}
                height={700}
                widths={[450, 900]}
                sizes="(min-width: 1024px) 480px, 92vw"
                loading="eager"
                fetchpriority="high"
                class="aspect-[4/3] w-full rounded-sm object-cover"
              />
            )
          }

          <div class="mt-8 rounded-sm border border-ebony-200 bg-white p-7">
            <h2 class="font-display text-[1.35rem] text-ebony-950">{t('label.includes')}</h2>
            <ul class="mt-5 space-y-3.5">
              {
                copy.includes.map((item) => (
                  <li class="flex items-start gap-3 text-[0.975rem] leading-relaxed text-ebony-700">
                    <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-gold-600" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    serviceFaqs.length > 0 && (
      <section class="bg-ebony-50 py-20 lg:py-24">
        <div class="container-x">
          <div class="max-w-3xl">
            <p class="eyebrow">{t('home.faqEyebrow')}</p>
            <h2 class="mt-4 text-[2rem] leading-[1.14] text-ebony-950 sm:text-[2.4rem]">
              {copy.name} — {t('faq.title').toLowerCase()}
            </h2>
            <div class="rule-gold mt-7 mb-12" />
            <FaqAccordion items={serviceFaqs} locale={locale} />
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-white py-20 lg:py-24">
    <div class="container-x">
      <h2 class="text-[1.9rem] text-ebony-950 sm:text-[2.2rem]">{t('services.relatedTitle')}</h2>
      <div class="rule-gold mt-6"></div>
      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s) => <ServiceCard service={s} locale={locale} />)}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
