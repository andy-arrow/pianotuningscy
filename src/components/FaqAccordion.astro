---
import type { Faq } from '~/data/faq';
import type { Locale } from '~/i18n/ui';

/**
 * Native <details>/<summary>. Works with JavaScript disabled, is keyboard
 * accessible for free, and the answers stay in the DOM so Google indexes them.
 */
interface Props { items: Faq[]; locale: Locale }
const { items, locale } = Astro.props;
---

<div class="divide-y divide-ebony-200 border-y border-ebony-200">
  {
    items.map((f) => (
      <details name="faq" class="group" data-reveal>
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left
                 font-display text-[1.2rem] leading-snug text-ebony-900 transition-colors
                 hover:text-gold-700 focus-visible:outline-offset-4 sm:text-[1.3rem]
                 [&::-webkit-details-marker]:hidden"
        >
          {f.q[locale]}
          <span
            aria-hidden="true"
            class="relative mt-1.5 h-4 w-4 shrink-0 text-gold-600"
          >
            <span class="absolute left-0 top-1/2 h-[1.5px] w-4 -translate-y-1/2 bg-current" />
            <span class="absolute left-1/2 top-0 h-4 w-[1.5px] -translate-x-1/2 bg-current transition-transform duration-300 group-open:rotate-90 group-open:opacity-0" />
          </span>
        </summary>
        <div class="pb-7 pr-10">
          <p class="prose-body max-w-2xl">{f.a[locale]}</p>
        </div>
      </details>
    ))
  }
</div>
