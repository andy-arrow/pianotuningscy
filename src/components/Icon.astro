const { name, class: className = '', ...rest } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  {...rest}
  set:html={paths[name]}
/>
