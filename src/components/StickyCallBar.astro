---
import { site } from '~/data/site';
import { useTranslations, path, type Locale } from '~/i18n/ui';
import Icon from '~/components/Icon.astro';

/**
 * Mobile-only sticky action bar. On a tradesperson's site the phone call IS the
 * conversion — the legacy site had no tap-to-call anywhere above the footer.
 * Appears after the hero so it never covers the first screen.
 */
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  data-sticky-bar
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-ebony-800 bg-ebony-950/95 backdrop-blur-md transition-transform duration-300 lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <div class="grid grid-cols-3 divide-x divide-ebony-800">
    <a
      href={`tel:${site.phone}`}
      data-analytics="sticky-call"
      class="flex min-h-[60px] flex-col items-center justify-center gap-1 py-2.5 text-white transition-colors active:bg-ebony-900"
    >
      <Icon name="phone" class="h-[18px] w-[18px] text-gold-500" />
      <span class="text-[0.75rem] font-semibold uppercase tracking-wider">{t('cta.call')}</span>
    </a>
    <a
      href={`https://wa.me/${site.whatsapp}`}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics="sticky-whatsapp"
      class="flex min-h-[60px] flex-col items-center justify-center gap-1 py-2.5 text-white transition-colors active:bg-ebony-900"
    >
      <Icon name="whatsapp" class="h-[18px] w-[18px] text-gold-500" />
      <span class="text-[0.75rem] font-semibold uppercase tracking-wider">WhatsApp</span>
    </a>
    <a
      href={path('book', locale)}
      data-analytics="sticky-book"
      class="flex min-h-[60px] flex-col items-center justify-center gap-1 bg-gold-600 py-2.5 text-white transition-colors active:bg-gold-700"
    >
      <Icon name="tuning" class="h-[18px] w-[18px]" />
      <span class="text-[0.75rem] font-semibold uppercase tracking-wider">{t('cta.book')}</span>
    </a>
  </div>
</div>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-sticky-bar]');
    if (!bar) return;
    let ticking = false;
    const update = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const show = window.scrollY > window.innerHeight * 0.6;
        bar.classList.toggle('translate-y-full', !show);
        ticking = false;
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
