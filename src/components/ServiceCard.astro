---
import type { Service } from '~/data/services';
import { useTranslations, servicePath, type Locale } from '~/i18n/ui';
import Icon from '~/components/Icon.astro';

interface Props { service: Service; locale: Locale; }
const { service, locale } = Astro.props;
const t = useTranslations(locale);
const copy = service[locale];

const priceLabel =
  service.price === null
    ? t('label.quoted')
    : `${service.priceFrom ? t('label.from') + ' ' : ''}€${service.price}`;
---

<a
  href={servicePath(service.slug, locale)}
  data-reveal
  class="card-hover group relative flex flex-col p-7 focus-visible:outline-offset-4"
>
  <span class="inline-flex h-12 w-12 items-center justify-center rounded-sm bg-gold-50 text-gold-700 transition-colors duration-300 group-hover:bg-gold-600 group-hover:text-white">
    <Icon name={service.icon as any} class="h-6 w-6" />
  </span>

  <h3 class="mt-5 text-[1.4rem] text-ebony-950">{copy.name}</h3>
  <p class="prose-body mt-2.5 flex-1 !text-[0.975rem] !leading-relaxed">{copy.summary}</p>

  <div class="mt-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3 border-t border-ebony-100 pt-5">
    <div>
      <span class="block text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-ebony-400">
        {t('label.price')}
      </span>
      <span class="mt-1 block font-display text-xl text-ebony-900">{priceLabel}</span>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-gold-700 transition-transform duration-300 group-hover:translate-x-1">
      {t('cta.learnMore')}
      <Icon name="arrow-right" class="h-4 w-4" />
    </span>
  </div>
</a>
