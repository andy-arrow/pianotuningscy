# Legacy Wix URLs → new structure.
# Every URL the old site had indexed is mapped to its closest equivalent so that
# ranking, bookmarks and any printed material keep working. 301 = permanent.
#
# Format: Netlify (_redirects). Cloudflare Pages reads this file too.
# For Vercel, the same map is mirrored in vercel.json.

# --- English pages ---
/blank-1                  /services/                           301
/blank-2                  /about/                              301
/blank-3                  /reviews/                            301
/blank-4                  /contact/                            301
/book-online              /book/                               301
/pricing-plans/plans-pricing   /services/piano-guardian/       301
/pricing-plans/*          /services/piano-guardian/            301
/paywall                  /                                    301
/plans                    /services/piano-guardian/            301

# --- English service pages ---
/service-page/piano-tuning                 /services/piano-tuning/          301
/service-page/piano-evaluation             /services/piano-evaluation/      301
/service-page/premium-grand-piano-rental   /services/grand-piano-rental/    301
/service-page/piano-cover                  /services/piano-covers/          301
/service-page/the-piano-guardian           /services/piano-guardian/        301
/service-page/*                            /services/                       301

# --- Wix booking system ---
/booking-calendar/piano-tuning                /book/?service=piano-tuning        301
/booking-calendar/piano-evaluation            /book/?service=piano-evaluation    301
/booking-calendar/premium-grand-piano-rental  /book/?service=grand-piano-rental  301
/booking-calendar/piano-cover                 /book/?service=piano-covers        301
/booking-calendar/the-piano-guardian          /book/?service=piano-guardian      301
/booking-calendar/*                           /book/                             301
/booking-form/*                               /book/                             301
/service-list/*                               /services/                         301

