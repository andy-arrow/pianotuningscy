# Response headers, shipped INSIDE the publish directory.
#
# netlify.toml lives at the repo root and is only read on a build-from-Git
# deploy. A direct/zip deploy uploads dist/ alone, so those headers were
# silently dropped — verified: no CSP, no Referrer-Policy, and assets served
# with max-age=0. This file lives in public/, so it lands in dist/ and applies
# to every deploy method, exactly like _redirects.
#
# Keep this in sync with netlify.toml.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://plausible.io https://pianotuningscy-chat.aroditis-andreas.workers.dev; form-action 'self' https://plausible.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  # Deliberately short. includeSubDomains would cover ftp.pianotuningscy.com,
  # which serves no valid HTTPS, and preload is effectively irreversible.
  # Raise to max-age=63072000; includeSubDomains once every subdomain is HTTPS.
  Strict-Transport-Security: max-age=300

# Fingerprinted build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
